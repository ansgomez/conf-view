# Container for the offline data refresh (scrapers.py + refresh.py). Run it to
# pull fresh CFP dates into data/conferences.json, then rebuild the site image.
#
#   docker compose run --rm refresh
#
# Mount ./data (compose does this) so the rewritten conferences.json lands on the
# host and the next `docker build` of the site bakes in the updated data.
# Pinned by digest (multi-arch index); Dependabot's docker ecosystem bumps it.
FROM python:3.15-slim@sha256:94d3426f1def7db4a106a232ac121bfd975393e5dfd40a619b955fae45fe7913

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

COPY scrapers.py refresh.py ./

# Run unprivileged; compose passes the host user's ids so the rewritten
# data/conferences.json stays owned by you, not by root.
USER 1000:1000

CMD ["python", "refresh.py"]
